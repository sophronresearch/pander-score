# Every benchmark run uses the OpenAI and Google credence judges, so these two
# keys are always required. Add the target provider's key as well.
OPENAI_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY= is also accepted instead of GOOGLE_API_KEY.

# Direct target providers.
ANTHROPIC_API_KEY=
XAI_API_KEY=

# OpenAI-compatible target providers. Inspect reads <NAME>_API_KEY and
# <NAME>_BASE_URL for model IDs beginning openai-api/<name>/.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

META_API_KEY=
# Copy the OpenAI-compatible URL from the Meta developer console.
META_BASE_URL=

ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
